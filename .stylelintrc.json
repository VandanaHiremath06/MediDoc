{
  "extends": "stylelint-config-standard",
  "ignoreFiles": ["supabase/**"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "theme",
          "variant",
          "custom-variant",
          "source",
          "screen"
        ]
      }
    ],
    "no-invalid-position-at-import-rule": null,
    "declaration-no-important": null,
    "selector-class-pattern": null
  }
}
